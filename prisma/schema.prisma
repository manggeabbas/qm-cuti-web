// ============================================================
// QM YWI — Web App Pengajuan Cuti, Izin & Monitoring Jadwal
// Database schema (PostgreSQL) — finalisasi ERD dari PRD v2.0
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------- Enums ----------------

enum RoleName {
  ADMIN
  SPV
  FOREMAN
  WAFOR
  KOORDINATOR
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

enum LeaveCategory {
  CFV
  CT
  SPECIAL_LEAVE
  PERMISSION
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  PENDING_KOORDINATOR
  PENDING_WAFOR
  PENDING_FOREMAN
  PENDING_SPV
  APPROVED
  REJECTED
  CANCEL_REQUESTED
  CANCELLED
  COMPLETED
}

enum ApprovalAction {
  APPROVED
  REJECTED
  RETURNED
}

enum WorkflowStepRole {
  KOORDINATOR
  WAFOR
  FOREMAN
  SPV
}

enum TxnKind {
  ALLOCATION
  USAGE
  CANCELLATION_REFUND
  CORRECTION
  EXPIRY
}

enum ConflictType {
  OVERLAP
  REGU
  JABATAN
}

enum ConflictSeverity {
  WARN
  BLOCK
}

enum OffKind {
  INDIVIDUAL
  COLLECTIVE
}

enum NotificationChannel {
  TELEGRAM
  WECOM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationEvent {
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCEL_REQUESTED
  LEAVE_CANCELLED
  LEAVE_CONFLICT
  APPROVAL_REQUIRED
  BALANCE_CHANGED
}

// ---------------- Auth & RBAC ----------------

model Role {
  id          Int       @id @default(autoincrement())
  name        RoleName  @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique // e.g. "employee:read", "leave:approve"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique // biasanya NIK
  passwordHash String
  employeeId   Int?        @unique
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  roles        UserRole[]
  sessions     UserSession[]
  auditLogs    AuditLog[]
  approvals    LeaveRequestApproval[] @relation("ApproverUser")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserSession {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------------- Struktur Organisasi ----------------

model Company {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  departments Department[]
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id         Int        @id @default(autoincrement())
  companyId  Int
  company    Company    @relation(fields: [companyId], references: [id])
  code       String     @unique
  name       String
  divisions  Division[]
  employees  Employee[]
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Division {
  id           Int        @id @default(autoincrement())
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  code         String     @unique
  name         String
  sections     Section[]
  employees    Employee[]
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Section {
  id         Int       @id @default(autoincrement())
  divisionId Int
  division   Division  @relation(fields: [divisionId], references: [id])
  code       String    @unique
  name       String
  teams      Team[]
  employees  Employee[]
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Team {
  id         Int       @id @default(autoincrement())
  sectionId  Int
  section    Section   @relation(fields: [sectionId], references: [id])
  code       String    @unique // REGU_A, REGU_B, REGU_C, LABORATORIUM
  name       String
  employees  Employee[]
  rosters    ShiftRoster[]
  workflows  ApprovalWorkflow[]
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Position {
  id                  Int        @id @default(autoincrement())
  code                String     @unique // SPV, WAKIL_SPV, FOREMAN, WAFOR, KOORDINATOR, CREW
  name                String
  levelOrder          Int        @default(0)
  isOperationalGroup  Boolean    @default(false) // Wafor/Foreman/Koordinator = satu kelompok konflik
  employees           Employee[]
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

// ---------------- Karyawan ----------------

model Employee {
  id             Int            @id @default(autoincrement())
  nik            String         @unique
  name           String
  effectiveDate  DateTime       @db.Date // tanggal efektif bekerja
  positionId     Int
  position       Position       @relation(fields: [positionId], references: [id])
  level          String?
  divisionId     Int
  division       Division       @relation(fields: [divisionId], references: [id])
  departmentId   Int
  department     Department     @relation(fields: [departmentId], references: [id])
  sectionId      Int
  section        Section        @relation(fields: [sectionId], references: [id])
  teamId         Int
  team           Team           @relation(fields: [teamId], references: [id])
  supervisorId   Int? // atasan langsung
  supervisor     Employee?      @relation("Supervisor", fields: [supervisorId], references: [id])
  subordinates   Employee[]     @relation("Supervisor")
  email          String?
  phone          String?
  status         EmployeeStatus @default(ACTIVE)
  offDayOfWeek   Int? // 0=Minggu..6=Sabtu; hari OFF mingguan tetap (Rabu OFF bersama)
  user           User?
  leaveRequests  LeaveRequest[]
  balanceTxns    LeaveBalanceTransaction[]
  balances       LeaveBalance[]
  offSchedules   OffSchedule[]
  telegramUser   TelegramUser?
  wechatUser     WechatUser?
  notifications  Notification[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([teamId])
  @@index([status])
  @@index([supervisorId])
}

// ---------------- Jenis Cuti ----------------

model LeaveType {
  id                   Int              @id @default(autoincrement())
  code                 String           @unique // CFV, CT, CUTI_MENIKAH, IZIN_PRIBADI, ...
  name                 String
  category             LeaveCategory
  defaultDays          Int? // hak default per periode (CFV=12, CT=12)
  eligibilityMonths    Int? // CFV=5, CT=12
  maxSingleDays        Int? // CT tunggal = 6
  maxCombinedWithCfv   Int? // CT gabung CFV = 4
  requiresAttachment   Boolean          @default(false)
  consumesBalance      Boolean          @default(true) // izin umumnya tidak memotong saldo
  countsAsLeaveDay     Boolean          @default(true)
  isActive             Boolean          @default(true)
  sortOrder            Int              @default(0)
  requests             LeaveRequest[]
  balanceTxns          LeaveBalanceTransaction[]
  balances             LeaveBalance[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

// ---------------- Saldo (ledger) ----------------

model LeaveBalanceTransaction {
  id           Int        @id @default(autoincrement())
  employeeId   Int
  employee     Employee   @relation(fields: [employeeId], references: [id])
  leaveTypeId  Int
  leaveType    LeaveType  @relation(fields: [leaveTypeId], references: [id])
  periodYear   Int // tahun periode hak
  kind         TxnKind
  days         Decimal    @db.Decimal(6, 2) // positif = penambahan, negatif = pemakaian
  requestId    Int?
  request      LeaveRequest? @relation(fields: [requestId], references: [id])
  note         String?
  createdById  Int?
  createdAt    DateTime   @default(now())

  @@index([employeeId, leaveTypeId, periodYear])
  @@index([requestId])
}

model LeaveBalance {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  periodYear  Int
  allocated   Decimal   @db.Decimal(8, 2) @default(0) // total hak
  used        Decimal   @db.Decimal(8, 2) @default(0) // terpakai (approved)
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, periodYear])
}

// ---------------- Pengajuan ----------------

model LeaveRequest {
  id                 Int           @id @default(autoincrement())
  employeeId         Int
  employee           Employee      @relation(fields: [employeeId], references: [id])
  leaveTypeId        Int
  leaveType          LeaveType     @relation(fields: [leaveTypeId], references: [id])
  packageId          String? // pengelompokan paket CFV+CT
  packageOrder       Int? // 1 = CFV, 2 = CT
  startDate          DateTime      @db.Date
  endDate            DateTime      @db.Date
  totalDays          Decimal       @db.Decimal(6, 2) // dihitung sistem, terkunci
  reason             String
  addressDuringLeave String?
  contactNumber      String?
  notes              String?
  status             RequestStatus @default(DRAFT)
  workflowId         Int?
  workflow           ApprovalWorkflow? @relation(fields: [workflowId], references: [id])
  currentStepOrder   Int? // langkah approval aktif
  submittedAt        DateTime?
  decidedAt          DateTime?
  cancelReason       String?
  approvals          LeaveRequestApproval[]
  attachments        LeaveAttachment[]
  conflicts          LeaveRequestConflict[]
  balanceTxns        LeaveBalanceTransaction[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([employeeId, status])
  @@index([status])
  @@index([startDate, endDate])
  @@index([packageId])
}

model LeaveRequestApproval {
  id             Int             @id @default(autoincrement())
  requestId      Int
  request        LeaveRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder      Int
  stepRole       WorkflowStepRole
  approverId     Int? // user yang bertindak
  approver       User?           @relation("ApproverUser", fields: [approverId], references: [id])
  action         ApprovalAction
  comment        String?
  createdAt      DateTime        @default(now())

  @@index([requestId])
}

model LeaveAttachment {
  id           Int          @id @default(autoincrement())
  requestId    Int
  request      LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filePath     String // path relatif di protected storage
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime     @default(now())
}

model LeaveRequestConflict {
  id           Int              @id @default(autoincrement())
  requestId    Int
  request      LeaveRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  conflictType ConflictType
  severity     ConflictSeverity
  description  String
  detectedAt   DateTime         @default(now())

  @@index([requestId])
}

// ---------------- Workflow Approval ----------------

model ApprovalWorkflow {
  id        Int                   @id @default(autoincrement())
  name      String
  teamId    Int? // null = default global
  team      Team?                 @relation(fields: [teamId], references: [id])
  isDefault Boolean               @default(false)
  isActive  Boolean               @default(true)
  steps     ApprovalWorkflowStep[]
  requests  LeaveRequest[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model ApprovalWorkflowStep {
  id         Int              @id @default(autoincrement())
  workflowId Int
  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder  Int
  role       WorkflowStepRole

  @@unique([workflowId, stepOrder])
}

// ---------------- Hari Libur ----------------

model Holiday {
  id                Int      @id @default(autoincrement())
  date              DateTime @unique @db.Date
  name              String
  countsAsLeaveDay  Boolean  @default(false) // apakah dihitung sebagai hari cuti
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------- Shift ----------------

model ShiftType {
  id        Int            @id @default(autoincrement())
  code      String         @unique // PAGI, SORE, MALAM
  name      String
  patterns  ShiftPattern[]
  rosters   ShiftRoster[]
  isActive  Boolean        @default(true)
}

model ShiftPattern {
  id          Int       @id @default(autoincrement())
  shiftTypeId Int
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0=Minggu .. 6=Sabtu
  startTime   String // "07:00"
  endTime     String // "15:00"
  label       String?

  @@unique([shiftTypeId, dayOfWeek])
}

model ShiftRoster {
  id          Int       @id @default(autoincrement())
  date        DateTime  @db.Date
  teamId      Int
  team        Team      @relation(fields: [teamId], references: [id])
  shiftTypeId Int
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([date, teamId])
  @@index([date])
}

// ---------------- OFF ----------------

model OffSchedule {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  kind       OffKind
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

// ---------------- Notifikasi ----------------

model TelegramUser {
  id             Int      @id @default(autoincrement())
  employeeId     Int      @unique
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  telegramUserId BigInt   @unique
  username       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WechatUser {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @unique
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wechatUserId String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id          Int                 @id @default(autoincrement())
  eventType   NotificationEvent
  employeeId  Int? // penerima (karyawan)
  employee    Employee?           @relation(fields: [employeeId], references: [id])
  channel     NotificationChannel
  title       String
  message     String              @db.Text
  actionUrl   String?
  status      NotificationStatus  @default(PENDING)
  attempts    Int                 @default(0)
  sentAt      DateTime?
  errorMessage String?            @db.Text
  logs        NotificationLog[]
  createdAt   DateTime            @default(now())

  @@index([status, createdAt])
  @@index([eventType])
}

model NotificationLog {
  id             Int       @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         NotificationStatus
  detail         String?   @db.Text
  createdAt      DateTime  @default(now())
}

// ---------------- Audit & Settings ----------------

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // LOGIN, CREATE_LEAVE_REQUEST, APPROVE, ...
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  key         String   @unique
  value       String // string; JSON untuk struktur kompleks
  description String?
  updatedAt   DateTime @updatedAt
}
